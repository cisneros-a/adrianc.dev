// Cloudflare config for To Do + (todo-plus.adrianc.dev).
// Iteration 1 is static assets only: no `main` entry, because there is no Worker code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "todo-plus",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./out",
    // Serve out/404.html (generated by Next.js) for unknown paths.
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "todo-plus.adrianc.dev",
      "custom_domain": true,
    },
  ],
}
