// Cloudflare config for the portfolio (adrianc.dev).
// Static assets only (D4): no `main` entry, because there is no Worker code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./out",
    // Serve out/404.html (generated by Next.js) for unknown paths.
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "adrianc.dev",
      "custom_domain": true,
    },
  ],
}
